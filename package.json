{
  "name": "kitchen-manager",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "personalize": "node scripts/personalize.mjs",
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @kitchen-manager/api dev",
    "dev:web": "pnpm --filter @kitchen-manager/web dev",
    "dev:desktop": "pnpm --filter @kitchen-manager/web exec cargo tauri dev",
    "dev:mobile": "pnpm --filter @kitchen-manager/mobile start",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test --filter=@kitchen-manager/api",
    "check": "biome check . && turbo typecheck",
    "format": "biome check --write .",
    "lint:actions": "actionlint",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "turbo": "^2.10.7"
  }
}
