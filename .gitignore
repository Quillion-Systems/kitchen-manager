# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Nitro (apps/api) build + generated types
.output/
.nitro/

# Turborepo
.turbo/

# Playwright (e2e)
e2e/playwright/.auth/
e2e/playwright-report/
e2e/test-results/
e2e/blob-report/

# Tauri (Rust) build artifacts
target/

# Expo prebuild output — regenerated from app.json / app.config.ts by
# `expo prebuild` / `expo run:ios` / `expo run:android`. Committing these
# means locking in native config that should live in the config plugin chain.
apps/mobile/ios/
apps/mobile/android/
apps/mobile/.expo/

# Env / secrets
.env
.env.*
!.env.example

# TLS certs / keys — provisioned onto the box from secrets, never committed
*.pem
*.key
deploy/certs/

# Generated per-env deploy config (holds secrets) — regenerated by
# deploy/bin/render-env.sh
deploy/envs/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test / coverage
coverage/
