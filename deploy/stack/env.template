# Every variable a per-env stack needs. This is DOCUMENTATION — the real files
# are generated per environment by deploy/bin/render-env.sh into deploy/envs/
# (gitignored; they hold secrets). Values below show the shape for "pr-101".
#
# Each env runs its OWN Postgres, so DB hosts are the in-stack service names and
# the DB names are fixed (isolation is the separate container + volume).

# --- identity (all derived from the env name) ---
ENV_NAME=pr-101
STACK=kitchen-manager-pr-101         # compose project + Traefik label namespace
HOST=pr-101.justinthymeapp.com       # the one hostname this env is served at
COMPOSE_PROJECT_NAME=kitchen-manager-pr-101

# --- images (the SAME images across every env; only tags vary) ---
IMAGE_WEB=ghcr.io/quillion-systems/kitchen-manager/web:<sha>
IMAGE_API=ghcr.io/quillion-systems/kitchen-manager/api:<sha>
IMAGE_API_MIGRATE=ghcr.io/quillion-systems/kitchen-manager/api-migrate:<sha>
IMAGE_API_SEED=ghcr.io/quillion-systems/kitchen-manager/api-seed:<sha>
POWERSYNC_IMAGE=journeyapps/powersync-service:1.23.3
POSTGRES_IMAGE=postgres:17-alpine

# --- this env's Postgres (a container in the stack, on its private network) ---
POSTGRES_USER=kitchen_manager
POSTGRES_PASSWORD=<secret>
DATABASE_URL=postgresql://kitchen_manager:<secret>@postgres:5432/kitchen_manager

# --- auth (per env) ---
BETTER_AUTH_SECRET=<secret>          # shared secret is fine for throwaway previews
BETTER_AUTH_URL=https://pr-101.justinthymeapp.com
TRUSTED_ORIGINS=https://pr-101.justinthymeapp.com,tauri://localhost,http://tauri.localhost

# --- browser-facing URLs injected into web at runtime (getConfig / __KITCHEN_MANAGER_CONFIG__) ---
API_URL=https://pr-101.justinthymeapp.com
POWERSYNC_URL=https://pr-101.justinthymeapp.com/powersync

# --- email verification (per env; rendered by render-env.sh) ---
# Prod is the only env that gates + sends: REQUIRE_EMAIL_VERIFICATION=true with SMTP
# pointed at Resend (SMTP_PASS = the PROD_RESEND_API_KEY secret). Every other env is
# gate-off with empty SMTP — sign-up sends no mail. WEB_URL is the public origin all
# verification links point at, so one link works from web/desktop/mobile.
REQUIRE_EMAIL_VERIFICATION=false     # prod: true
WEB_URL=https://pr-101.justinthymeapp.com
EMAIL_FROM=Kitchen Manager <no-reply@justinthymeapp.com>
SMTP_HOST=                           # prod: smtp.resend.com
SMTP_PORT=                           # prod: 587
SMTP_USER=                           # prod: resend
SMTP_PASS=<secret>                   # prod: the Resend API key

# --- PowerSync service ---
PS_DATA_SOURCE_URI=postgresql://kitchen_manager:<secret>@postgres:5432/kitchen_manager
PS_STORAGE_SOURCE_URI=postgresql://kitchen_manager:<secret>@powersync-storage:5432/powersync
PS_JWKS_URL=http://kitchen-manager-pr-101-api:3001/api/auth/jwks  # this env's API, unique alias
PS_PORT=8080
